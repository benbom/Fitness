# Kopiera till .env.local (Next.js standard). Gitignore:ad.
# Produktion: Vercel Environment Variables. Preview/staging: separata Vercel-env.

# Nästa
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=0.0.0

# Supabase — hämta från supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # Endast server-side, aldrig NEXT_PUBLIC_

# Supabase Postgres (för Prisma migrations)
DATABASE_URL=postgresql://postgres:<pwd>@db.<project-id>.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:<pwd>@db.<project-id>.supabase.co:5432/postgres

# Kolumn-kryptering för Klass 2-data (injury notes m.fl., ADR-004).
# 32 bytes base64. Generera lokalt en gång:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotera aldrig i drift utan att först re-encrypta befintliga rader.
COLUMN_ENCRYPTION_KEY=<base64-32-bytes>

# Stripe — testnycklar från dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mux (video) — dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=...
MUX_TOKEN_SECRET=...

# Sanity (innehåll) — sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=...
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=...

# Resend (e-post)
RESEND_API_KEY=re_...

# PostHog (analytics, self-hosted i EU)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Sentry — DSN kan exponeras publikt (designat för klient-bruk).
# Samma DSN i båda vars; server-vars läser SENTRY_DSN, client-bunt läser NEXT_PUBLIC_SENTRY_DSN.
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN behövs bara i CI/build för source-map-uppladdning
SENTRY_AUTH_TOKEN=...
