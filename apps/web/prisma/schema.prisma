// Vera Prisma schema.
//
// Datasource pekar mot Supabase Postgres via DATABASE_URL (pooled
// connection för runtime queries) och DIRECT_URL (Session pooler för
// prisma migrate). Båda finns i .env.example.
//
// Ansvarsfördelning:
//  - Prisma äger tabellstruktur och kolumner
//  - Supabase äger auth-schemat (`auth.users` är källa för id)
//  - RLS-policies deklareras i SQL-migrationsfilerna (Prisma stödjer
//    inte native RLS-uttryck)
//
// Modeller läggs till per bounded context i respektive PR.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgsodium, pgcrypto, pg_stat_statements]
}

/// Vad användaren siktar mot. Multi-select — flera mål samtidigt tillåtna.
enum Goal {
  get_stronger
  feel_better
  postpartum_recovery
  perimenopause
  event_prep
}

/// Erfarenhetsnivå. Styr initial programgenerering (adaptiv motor, C-04).
enum Level {
  beginner
  experienced
  lifts_heavy
}

/// Tillgänglig utrustning. Multi-select — filtrerar övningsval.
enum Equipment {
  home
  gym
  outdoor
}

/// Typ av samtycke. Utökas när nya samtyckesytor tillkommer.
enum ConsentType {
  terms_privacy
  marketing
  health_data
}

/// Om samtycket gavs eller drogs tillbaka.
enum ConsentAction {
  granted
  revoked
}

/// Append-only samtyckesloggning (ADR-004, M0-23).
///
/// En rad per samtyckesbeslut. Aldrig UPDATE eller DELETE i application-
/// koden — revoke är ny rad med action=revoked, inte redigering av
/// tidigare rad. Detta ger en immutable audit trail som klarar
/// GDPR-granskning.
///
/// Cascade delete via FK till auth.users(id) — hela historiken försvinner
/// när kontot raderas. RLS: bara ägaren får läsa/insertera egna rader,
/// inga UPDATE/DELETE-policies (application-level enforced).
model Consent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      ConsentType
  action    ConsentAction
  textShown String        @map("text_shown")
  screenId  String        @map("screen_id")
  userAgent String?       @map("user_agent")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, type, createdAt(sort: Desc)])
  @@map("consent")
}

/// Profile — en rad per användare (C-02).
///
/// `id` matchar `auth.users(id)` i Supabase — FK och ON DELETE CASCADE
/// deklareras i migrationsfilerna, eftersom Prisma inte uttrycker
/// cross-schema-FK direkt.
///
/// RLS: bara ägaren får läsa/skriva sin egen rad. Enforcement i migration.
///
/// Data-klass: 3 (Personlig, ADR-004). Injury-flaggor (Klass 2)
/// hanteras separat i #29 med kolumn-kryptering.
model Profile {
  id             String      @id @db.Uuid
  goals          Goal[]      @default([])
  level          Level?
  equipment      Equipment[] @default([])
  daysPerWeek    Int?        @map("days_per_week")
  timePerSession Int?        @map("time_per_session")
  notifPrefs     Json        @default("{}") @map("notif_prefs")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("profile")
}
