// Vera Prisma schema.
//
// Datasource pekar mot Supabase Postgres via DATABASE_URL (pooled
// connection för runtime queries) och DIRECT_URL (Session pooler för
// prisma migrate). Båda finns i .env.example.
//
// Ansvarsfördelning:
//  - Prisma äger tabellstruktur och kolumner
//  - Supabase äger auth-schemat (`auth.users` är källa för id)
//  - RLS-policies deklareras i SQL-migrationsfilerna (Prisma stödjer
//    inte native RLS-uttryck)
//
// Modeller läggs till per bounded context i respektive PR.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgsodium, pgcrypto, pg_stat_statements]
}

/// Vad användaren siktar mot. Multi-select — flera mål samtidigt tillåtna.
enum Goal {
  get_stronger
  feel_better
  postpartum_recovery
  perimenopause
  event_prep
}

/// Erfarenhetsnivå. Styr initial programgenerering (adaptiv motor, C-04).
enum Level {
  beginner
  experienced
  lifts_heavy
}

/// Tillgänglig utrustning. Multi-select — filtrerar övningsval.
enum Equipment {
  home
  gym
  outdoor
}

/// Typ av samtycke. Utökas när nya samtyckesytor tillkommer.
enum ConsentType {
  terms_privacy
  marketing
  health_data
}

/// Om samtycket gavs eller drogs tillbaka.
enum ConsentAction {
  granted
  revoked
}

/// Kroppsområden som skada/kontraindikation kan gälla (M0-29, F-ON-04).
/// Standardiserad checklista — läggs till försiktigt eftersom
/// Adaptive Engine (M2) filtrerar övningar på dessa värden.
enum InjuryArea {
  back
  knee
  shoulder
  pelvic_floor
  diastasis
  other
}

/// Grad av begränsning. `none` betyder att flaggan aktivt är rensad
/// (till skillnad från att raden inte finns alls).
enum InjurySeverity {
  none
  mild
  moderate
  severe
}

/// Audit-händelser på injury_flag. Rad skrivs av trigger vid
/// INSERT/UPDATE/DELETE och kan aldrig ändras.
enum InjuryAuditAction {
  insert
  update
  delete
}

/// Append-only samtyckesloggning (ADR-004, M0-23).
///
/// En rad per samtyckesbeslut. Aldrig UPDATE eller DELETE i application-
/// koden — revoke är ny rad med action=revoked, inte redigering av
/// tidigare rad. Detta ger en immutable audit trail som klarar
/// GDPR-granskning.
///
/// Cascade delete via FK till auth.users(id) — hela historiken försvinner
/// när kontot raderas. RLS: bara ägaren får läsa/insertera egna rader,
/// inga UPDATE/DELETE-policies (application-level enforced).
model Consent {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      ConsentType
  action    ConsentAction
  textShown String        @map("text_shown")
  screenId  String        @map("screen_id")
  userAgent String?       @map("user_agent")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, type, createdAt(sort: Desc)])
  @@map("consent")
}

/// Profile — en rad per användare (C-02).
///
/// `id` matchar `auth.users(id)` i Supabase — FK och ON DELETE CASCADE
/// deklareras i migrationsfilerna, eftersom Prisma inte uttrycker
/// cross-schema-FK direkt.
///
/// RLS: bara ägaren får läsa/skriva sin egen rad. Enforcement i migration.
///
/// Data-klass: 3 (Personlig, ADR-004). Injury-flaggor (Klass 2)
/// hanteras separat i #29 med kolumn-kryptering.
model Profile {
  id             String      @id @db.Uuid
  goals          Goal[]      @default([])
  level          Level?
  equipment      Equipment[] @default([])
  daysPerWeek    Int?        @map("days_per_week")
  timePerSession Int?        @map("time_per_session")
  notifPrefs     Json        @default("{}") @map("notif_prefs")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@map("profile")
}

/// InjuryFlag — en rad per (användare, kroppsområde) som täcker
/// nuvarande status för den regionen (C-02, M0-29).
///
/// Data-klass: 2 (Känslig, ADR-004). `note` är kolumn-krypterad
/// med AES-256-GCM (se lib/crypto/column.ts). Aldrig loggad i klartext.
///
/// Adaptive Engine (M2) läser (area, severity) direkt — inte note.
/// Trigger `injury_flag_audit_trg` skriver till InjuryFlagAudit på
/// alla INSERT/UPDATE/DELETE.
model InjuryFlag {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  area      InjuryArea
  severity  InjurySeverity @default(none)
  note      Bytes?
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([userId, area])
  @@map("injury_flag")
}

/// Append-only audit-logg för injury_flag (M0-29 AC 2).
/// Skrivs av databastrigger — application-koden kan inte kringgå den.
/// Inga UPDATE/DELETE-policies i RLS.
model InjuryFlagAudit {
  id           String            @id @default(uuid()) @db.Uuid
  injuryFlagId String            @map("injury_flag_id") @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  action       InjuryAuditAction
  changedAt    DateTime          @default(now()) @map("changed_at")

  @@index([userId, changedAt(sort: Desc)])
  @@map("injury_flag_audit")
}
