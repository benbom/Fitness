auto-install-peers=true
strict-peer-dependencies=false
engine-strict=true
save-workspace-protocol=rolling

# Fetch platform-specific native bindings for all supported OS/arch combos.
# Krävs för att t.ex. eslint-import-resolver-typescript / unrs-resolver
# ska funka på både Windows-utveckling och Linux-CI utan att lokala
# devDeps behöver namnge Windows-specifika binärer explicit.
supported-architectures[cpu]=x64,arm64
supported-architectures[os]=linux,darwin,win32
supported-architectures[libc]=glibc
