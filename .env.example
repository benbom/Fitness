# Kopiera till .env och fyll i lokala värden.
# .env är gitignore:ad — hemligheter går i Secrets Manager i staging/prod (se M0-12).

# API
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
APP_VERSION=0.0.0
GIT_SHA=dev

# Postgres — matchar docker-compose.yml
DATABASE_URL=postgresql://vera:vera@localhost:5432/vera_dev

# Redis — matchar docker-compose.yml
REDIS_URL=redis://localhost:6379

# Externa tjänster (fylls i från M0-30 och framåt)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# ORY_KRATOS_ADMIN_URL=http://localhost:4434
# ORY_KRATOS_PUBLIC_URL=http://localhost:4433
