{
  "name": "vera",
  "version": "0.0.0",
  "private": true,
  "description": "Vera — träningsapp för kvinnor. Monorepo-root.",
  "repository": {
    "type": "git",
    "url": "https://github.com/benbom/Fitness.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@vera/eslint-config": "workspace:*",
    "@vera/prettier-config": "workspace:*",
    "@vera/tsconfig": "workspace:*",
    "eslint": "^8.57.1",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "turbo": "^2.5.0",
    "typescript": "^5.6.2"
  },
  "prettier": "@vera/prettier-config"
}
